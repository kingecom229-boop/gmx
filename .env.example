# ============================================================
# GMX Motors — variables d'environnement
# Copiez ce fichier vers `.env` puis renseignez vos valeurs.
#   Commande Windows :  copy .env.example .env
#   Commande Linux/mac : cp .env.example .env
# Le fichier `.env` est ignoré par Git : ne le versionnez jamais.
# ============================================================

# ------------------------------------------------------------
# 1. SUPABASE — obligatoire
#    Tableau de bord : https://supabase.com/dashboard
#    Projet > Settings > API
# ------------------------------------------------------------

# URL du projet, ex. https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co

# Clé PUBLIQUE (publishable / anon). Elle est embarquée dans le bundle
# navigateur : elle n'est sensible QUE si la RLS est correctement configurée.
VITE_SUPABASE_ANON_KEY=sb_publishable_VOTRE_CLE_PUBLIQUE

# ------------------------------------------------------------
# 2. API locale (serveur Express) — valeurs par défaut OK en local
# ------------------------------------------------------------

# Port du serveur API
PORT=8787

# Origine autorisée pour le CORS (frontend). Séparées par des virgules.
CORS_ORIGIN=http://localhost:5173

# Mode de développement ou production
NODE_ENV=development

# ------------------------------------------------------------
# 3. SERVEUR → SUPABASE (CÔTÉ SERVEUR UNIQUEMENT, JAMAIS DANS LE FRONT)
# ------------------------------------------------------------

# Clé SECRÈTE Supabase (Dashboard > Settings > API Keys > "Secret keys").
# Équivalente à l'ancienne service_role. Utilisée par le serveur API pour
# écrire les demandes de devis de façon fiable.
# Si elle est absente, le serveur retombe sur la clé publique et la RLS
# s'applique intégralement (les devis restent enregistrables).
SUPABASE_SECRET_KEY=

# Clé publique, réutilisée côté serveur lorsque SUPABASE_SECRET_KEY est absente.
# Laissez vide pour réutiliser automatiquement VITE_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# 4. ENVOI DES E-MAILS (devis) — optionnel mais recommandé
#    Sans configuration, les devis sont quand même enregistrés et une
#    notification est placée dans la file d'attente (email_outbox).
# ------------------------------------------------------------

# Fournisseur : "resend" (seul fournisseur implémenté) ou vide = file d'attente seule
MAIL_PROVIDER=

# Clé API Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Expéditeur (doit appartenir à un domaine vérifié chez Resend)
MAIL_FROM="GMX Motors <devis@gmx-motors.fr>"

# Adresse commerciale destinataire des demandes de devis
QUOTE_NOTIFICATION_EMAIL=gmx@gmx.com

# Envoyer un accusé de réception au client ? (true/false)
MAIL_SEND_CUSTOMER_ACK=true

# ------------------------------------------------------------
# 5. SÉCURITÉ — recommandé
# ------------------------------------------------------------

# Secret utilisé pour hasher les adresses IP enregistrées avec les devis (RGPD).
# Mettez une longue chaîne aléatoire et ne la changez pas en production.
IP_HASH_SECRET=changez-moi-avec-une-longue-chaine-aleatoire

# Clé d'initialisation du premier administrateur (script `npm run admin:create`).
# Obligatoire uniquement pendant l'initialisation ; laissez vide ensuite.
ADMIN_BOOTSTRAP_TOKEN=

# ------------------------------------------------------------
# 6. FRONT — optionnel
# ------------------------------------------------------------

# Mode de démonstration : affiche un bandeau "données de démonstration"
VITE_DEMO_BANNER=true
